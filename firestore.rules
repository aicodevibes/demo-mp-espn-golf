rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: config
// Document ID: {docId} (e.g., 'app')
// Fields:
//   - activeEventId: string (required, 0..100 chars) - active ESPN event ID
//   - activeSeason: number (required, 2000..2100) - active tournament season year
//   - updatedAt: timestamp (optional) - server timestamp of last update
//   - updatedBy: string (optional, 1..150 chars) - email/identifier of updater
//
// Collection: trackedEvents
// Document ID: {eventId}
// Fields:
//   - name: string (required, 1..200 chars) - tournament display name
//   - eventId: string (optional, must match {eventId}, 1..100 chars) - event ID
//   - espnEventId: string (optional, must match {eventId}, 1..100 chars) - ESPN event ID
//   - season: number (optional, 2000..2100) - tournament season year
//   - date: string (optional, 0..64 chars) - tournament date label/ISO string
//   - isActive: bool (optional) - whether event is active
//   - createdAt: timestamp (optional) - server timestamp of creation
//   - updatedAt: timestamp (optional) - server timestamp of last update
//   - updatedBy: string (optional, 1..150 chars) - email/identifier of updater
//
// Collection: trackedPlayers
// Document ID: {playerId}
// Fields:
//   - playerId: string (required, must match document {playerId}, 1..64 chars)
//   - name: string (required, 1..120 chars)
//   - headshotUrl: string (optional, empty or valid http/https URL <= 1024 chars)
//   - country: string (optional, 0..32 chars)
//   - displayOrder: number (optional, 0..10000)
//   - addedAt: timestamp (optional)
//
// Collection: players
// Document ID: {playerId}
// Fields:
//   - id: string (required, must match document {playerId}, 1..64 chars)
//   - name: string (required, 1..120 chars)
//   - headshotUrl: string (optional, empty or valid http/https URL <= 1024 chars)
//   - country: string (optional, 0..32 chars)
//   - countryFlag: string (optional, empty or valid http/https URL <= 1024 chars)
//   - lastUpdated: timestamp (optional)
//
// Collection: participants (top-level legacy/shared roster) &
// Subcollection: events/{eventId}/participants
// Document ID: {participantId}
// Fields:
//   - id: string (required, must match document {participantId}, 1..128 chars)
//   - name: string (required, 1..100 chars)
//   - draftedPlayerIds: list of strings (required, size 0..10, each 1..64 chars)
//   - isGreedyParticipant: bool (optional)
//   - greedyPlayerId: string or null (optional, 0..64 chars)
//   - hasPaidEntry: bool (optional)
//   - hasPaidGreedy: bool (optional)
//
// Collection: events
// Document ID: {eventId}
// Fields:
//   - id: string (optional, must match {eventId}, 1..100 chars) - event ID
//   - espnEventId: string (optional, must match {eventId}, 1..100 chars) - ESPN event ID
//   - name: string (required unless eventName is present, 1..200 chars) - tournament name
//   - eventName: string (required unless name is present, 1..200 chars) - tournament name alias
//   - season: number (optional, 2000..2100) - tournament season year
//   - date: string (optional, 0..64 chars) - tournament date label/ISO string
//   - createdAt: timestamp (optional) - server timestamp of creation
//   - updatedAt: timestamp (optional) - server timestamp of last update
//   - updatedBy: string (optional, 1..150 chars) - email/identifier of updater
//
// Subcollection: events/{eventId}/contestConfig
// Document ID: {docId} (e.g., 'default')
// Fields:
//   - espnEventId: string (required on create, must match {eventId}, 1..100 chars, immutable)
//   - eventName: string (required on create, 1..200 chars)
//   - season: number (required on create, 2000..2100)
//   - mainPayouts: list of numbers (required on create, size 1..20, each 0..1000000)
//   - dayMoneyPool: number (required on create, 0..1000000)
//   - coursePar: number or null (optional, 20..150 if number)
//   - hasCut: bool (optional)
//   - entryFee: number (optional, 0..1000000)
//   - greedyEntryFee: number (optional, 0..1000000)
//   - isFinalized: bool (optional)
//   - createdAt: timestamp (optional, immutable once set)
//   - updatedAt: timestamp (optional)
//   - updatedBy: string (optional, 1..150 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Verified allowlisted admin only (never trust client-supplied document fields)
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'aicodevibes@gmail.com';
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUrl(url) {
      return url is string &&
        url.size() <= 1024 &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    function isValidUrlOrEmpty(val) {
      return val == '' || isValidUrl(val);
    }

    function isValidPayoutSlot(lst, idx) {
      return lst.size() <= idx ||
        (lst[idx] is number && lst[idx] >= 0 && lst[idx] <= 1000000);
    }

    function isValidPayoutList(lst) {
      return lst is list &&
        lst.size() >= 1 &&
        lst.size() <= 20 &&
        isValidPayoutSlot(lst, 0) &&
        isValidPayoutSlot(lst, 1) &&
        isValidPayoutSlot(lst, 2) &&
        isValidPayoutSlot(lst, 3) &&
        isValidPayoutSlot(lst, 4) &&
        isValidPayoutSlot(lst, 5) &&
        isValidPayoutSlot(lst, 6) &&
        isValidPayoutSlot(lst, 7) &&
        isValidPayoutSlot(lst, 8) &&
        isValidPayoutSlot(lst, 9) &&
        isValidPayoutSlot(lst, 10) &&
        isValidPayoutSlot(lst, 11) &&
        isValidPayoutSlot(lst, 12) &&
        isValidPayoutSlot(lst, 13) &&
        isValidPayoutSlot(lst, 14) &&
        isValidPayoutSlot(lst, 15) &&
        isValidPayoutSlot(lst, 16) &&
        isValidPayoutSlot(lst, 17) &&
        isValidPayoutSlot(lst, 18) &&
        isValidPayoutSlot(lst, 19);
    }

    function isValidPlayerIdSlot(lst, idx) {
      return lst.size() <= idx ||
        (lst[idx] is string && lst[idx].size() > 0 && lst[idx].size() <= 64);
    }

    function isValidDraftedPlayerList(lst) {
      return lst is list &&
        lst.size() <= 10 &&
        isValidPlayerIdSlot(lst, 0) &&
        isValidPlayerIdSlot(lst, 1) &&
        isValidPlayerIdSlot(lst, 2) &&
        isValidPlayerIdSlot(lst, 3) &&
        isValidPlayerIdSlot(lst, 4) &&
        isValidPlayerIdSlot(lst, 5) &&
        isValidPlayerIdSlot(lst, 6) &&
        isValidPlayerIdSlot(lst, 7) &&
        isValidPlayerIdSlot(lst, 8) &&
        isValidPlayerIdSlot(lst, 9);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAppConfig(data) {
      return hasOnlyAllowedFields(['activeEventId', 'activeSeason', 'updatedAt', 'updatedBy']) &&
        hasRequiredFields(['activeEventId', 'activeSeason']) &&
        validStringLength(data.activeEventId, 0, 100) &&
        data.activeSeason is number &&
        data.activeSeason >= 2000 &&
        data.activeSeason <= 2100 &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('updatedBy' in data) || validStringLength(data.updatedBy, 1, 150));
    }

    function isValidContestConfigFields(data, eventId) {
      return hasOnlyAllowedFields([
          'espnEventId', 'eventName', 'season', 'mainPayouts', 'dayMoneyPool',
          'coursePar', 'hasCut', 'entryFee', 'greedyEntryFee', 'isFinalized',
          'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        (!('espnEventId' in data) || (validStringLength(data.espnEventId, 1, 100) && data.espnEventId == eventId)) &&
        (!('eventName' in data) || validStringLength(data.eventName, 1, 200)) &&
        (!('season' in data) || (data.season is number && data.season >= 2000 && data.season <= 2100)) &&
        (!('mainPayouts' in data) || isValidPayoutList(data.mainPayouts)) &&
        (!('dayMoneyPool' in data) || (data.dayMoneyPool is number && data.dayMoneyPool >= 0 && data.dayMoneyPool <= 1000000)) &&
        (!('coursePar' in data) || data.coursePar == null || (data.coursePar is number && data.coursePar >= 20 && data.coursePar <= 150)) &&
        (!('hasCut' in data) || data.hasCut is bool) &&
        (!('entryFee' in data) || (data.entryFee is number && data.entryFee >= 0 && data.entryFee <= 1000000)) &&
        (!('greedyEntryFee' in data) || (data.greedyEntryFee is number && data.greedyEntryFee >= 0 && data.greedyEntryFee <= 1000000)) &&
        (!('isFinalized' in data) || data.isFinalized is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('updatedBy' in data) || validStringLength(data.updatedBy, 1, 150));
    }

    function isValidParticipant(data, participantId) {
      return hasOnlyAllowedFields([
          'id', 'name', 'draftedPlayerIds', 'isGreedyParticipant',
          'greedyPlayerId', 'hasPaidEntry', 'hasPaidGreedy'
        ]) &&
        hasRequiredFields(['id', 'name', 'draftedPlayerIds']) &&
        validStringLength(data.id, 1, 128) &&
        data.id == participantId &&
        validStringLength(data.name, 1, 100) &&
        isValidDraftedPlayerList(data.draftedPlayerIds) &&
        (!('isGreedyParticipant' in data) || data.isGreedyParticipant is bool) &&
        (!('greedyPlayerId' in data) || data.greedyPlayerId == null || validStringLength(data.greedyPlayerId, 0, 64)) &&
        (!('hasPaidEntry' in data) || data.hasPaidEntry is bool) &&
        (!('hasPaidGreedy' in data) || data.hasPaidGreedy is bool);
    }

    function isValidPlayer(data, playerId) {
      return hasOnlyAllowedFields(['id', 'name', 'headshotUrl', 'country', 'countryFlag', 'lastUpdated']) &&
        hasRequiredFields(['id', 'name']) &&
        validStringLength(data.id, 1, 64) &&
        data.id == playerId &&
        validStringLength(data.name, 1, 120) &&
        (!('headshotUrl' in data) || isValidUrlOrEmpty(data.headshotUrl)) &&
        (!('country' in data) || validStringLength(data.country, 0, 32)) &&
        (!('countryFlag' in data) || isValidUrlOrEmpty(data.countryFlag)) &&
        (!('lastUpdated' in data) || data.lastUpdated is timestamp);
    }

    function isValidTrackedPlayer(data, playerId) {
      return hasOnlyAllowedFields(['playerId', 'name', 'headshotUrl', 'country', 'displayOrder', 'addedAt']) &&
        hasRequiredFields(['playerId', 'name']) &&
        validStringLength(data.playerId, 1, 64) &&
        data.playerId == playerId &&
        validStringLength(data.name, 1, 120) &&
        (!('headshotUrl' in data) || isValidUrlOrEmpty(data.headshotUrl)) &&
        (!('country' in data) || validStringLength(data.country, 0, 32)) &&
        (!('displayOrder' in data) || (data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 10000)) &&
        (!('addedAt' in data) || data.addedAt is timestamp);
    }

    function isValidTrackedEvent(data, eventId) {
      return hasOnlyAllowedFields([
          'name', 'eventId', 'espnEventId', 'season', 'date',
          'isActive', 'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        hasRequiredFields(['name']) &&
        validStringLength(data.name, 1, 200) &&
        (!('eventId' in data) || (validStringLength(data.eventId, 1, 100) && data.eventId == eventId)) &&
        (!('espnEventId' in data) || (validStringLength(data.espnEventId, 1, 100) && data.espnEventId == eventId)) &&
        (!('season' in data) || (data.season is number && data.season >= 2000 && data.season <= 2100)) &&
        (!('date' in data) || validStringLength(data.date, 0, 64)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('updatedBy' in data) || validStringLength(data.updatedBy, 1, 150));
    }

    function isValidEvent(data, eventId) {
      return hasOnlyAllowedFields([
          'id', 'espnEventId', 'name', 'eventName', 'season',
          'date', 'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        ('name' in data || 'eventName' in data) &&
        (!('id' in data) || (validStringLength(data.id, 1, 100) && data.id == eventId)) &&
        (!('espnEventId' in data) || (validStringLength(data.espnEventId, 1, 100) && data.espnEventId == eventId)) &&
        (!('name' in data) || validStringLength(data.name, 1, 200)) &&
        (!('eventName' in data) || validStringLength(data.eventName, 1, 200)) &&
        (!('season' in data) || (data.season is number && data.season >= 2000 && data.season <= 2100)) &&
        (!('date' in data) || validStringLength(data.date, 0, 64)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('updatedBy' in data) || validStringLength(data.updatedBy, 1, 150));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public read for tournament & player configuration; admin-only validated writes
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAppConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    match /trackedEvents/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTrackedEvent(request.resource.data, eventId);
      allow delete: if isAdmin();
    }

    match /trackedPlayers/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTrackedPlayer(request.resource.data, playerId);
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPlayer(request.resource.data, playerId);
      allow delete: if isAdmin();
    }

    match /participants/{participantId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidParticipant(request.resource.data, participantId);
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidEvent(request.resource.data, eventId);
      allow delete: if isAdmin();

      match /contestConfig/{docId} {
        allow read: if true;
        allow create: if isAdmin() &&
          hasRequiredFields(['espnEventId', 'eventName', 'season', 'mainPayouts', 'dayMoneyPool']) &&
          isValidContestConfigFields(request.resource.data, eventId);
        allow update: if isAdmin() &&
          isValidContestConfigFields(request.resource.data, eventId) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (!('espnEventId' in resource.data) || request.resource.data.espnEventId == resource.data.espnEventId);
        allow delete: if isAdmin();
      }

      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidParticipant(request.resource.data, participantId);
        allow delete: if isAdmin();
      }

      // Public read fallback for subcollections; deny unvalidated writes to unknown subcollections
      // (Explicit subcollection rules above handle contestConfig & participants writes)
      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
